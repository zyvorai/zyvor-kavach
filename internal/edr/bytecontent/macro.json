  {
   "id": "byte-macro-dde-exec",
   "name": "DDE auto-link with a command",
   "description": "DDEAUTO/DDE field codes carrying cmd or powershell, or a spreadsheet formula injecting a command via the pipe syntax.",
   "tactic": "Execution",
   "technique": "T1559.002",
   "severity": "medium",
   "weight": 35,
   "applies_to": "both",
   "format": "any",
   "strings": [
    {
     "name": "a",
     "type": "regex",
     "value": "\\bDDE(?:AUTO)?\\b\\s+\\\"?[^\\n]{0,40}(?:cmd|powershell|mshta|regsvr32)",
     "nocase": true
    },
    {
     "name": "f",
     "type": "regex",
     "value": "^[=+@\\-]\\s*(?:cmd|powershell|mshta)\\s*\\|\\s*['\\\"]\\s*/[cC]\\s",
     "nocase": true
    }
   ],
   "condition": {
    "any": [
     {
      "str": "a"
     },
     {
      "str": "f"
     }
    ]
   },
   "samples": {
    "positive": [
     {
      "text": "DDEAUTO c:\\\\windows\\\\system32\\\\cmd.exe \"/k calc.exe\""
     }
    ],
    "negative": [
     {
      "text": "The DDE protocol is old"
     },
     {
      "text": "=SUM(A1:A2)"
     }
    ]
   }
  },
