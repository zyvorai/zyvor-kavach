{
 "pack": "macro",
 "rules": [
  {
   "id": "byte-macro-ole-autoexec-shell",
   "name": "Legacy Office document with auto-run and shell strings",
   "description": "OLE2 compound file containing an auto-run macro name and process-launch or download strings.",
   "tactic": "Execution",
   "technique": "T1204.002",
   "severity": "high",
   "weight": 55,
   "applies_to": "file",
   "format": "any",
   "strings": [
    {
     "name": "a",
     "type": "ascii",
     "value": "AutoOpen"
    },
    {
     "name": "b",
     "type": "ascii",
     "value": "Document_Open"
    },
    {
     "name": "c",
     "type": "ascii",
     "value": "Workbook_Open"
    },
    {
     "name": "d",
     "type": "ascii",
     "value": "Auto_Open"
    },
    {
     "name": "e",
     "type": "ascii",
     "value": "Document_Close"
    },
    {
     "name": "s",
     "type": "regex",
     "value": "CreateObject\\s*\\(\\s*\\\"WScript\\.Shell\\\"|\\bShell\\s*\\(|URLDownloadToFile|powershell|cmd\\.exe\\s*/c|MSXML2\\.XMLHTTP|\\.Run\\s*\\(",
     "nocase": true
    }
   ],
   "condition": {
    "all": [
     {
      "any": [
       {
        "str": "a"
       },
       {
        "str": "b"
       },
       {
        "str": "c"
       },
       {
        "str": "d"
       },
       {
        "str": "e"
       }
      ]
     },
     {
      "str": "s"
     }
    ]
   },
   "magic": "d0cf11e0a1b11ae1",
   "samples": {
    "positive": [
     {
      "b64": "0M8R4KGxGuEAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAQXR0cmlidXRlIFZCX05hbWUgPSAiVGhpc0RvY3VtZW50IgpTdWIgQXV0b09wZW4oKQpDcmVhdGVPYmplY3QoIldTY3JpcHQuU2hlbGwiKS5SdW4gImNtZC5leGUgL2MgY2FsYyIKRW5kIFN1Yg=="
     }
    ],
    "negative": [
     {
      "b64": "0M8R4KGxGuEAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAU3ViIEF1dG9PcGVuKCkKTXNnQm94ICJIaSIKRW5kIFN1Yg=="
     },
