   "severity": "high",
   "weight": 50,
   "applies_to": "both",
   "format": "script",
   "strings": [
    {
     "name": "a",
     "type": "regex",
     "value": "new\\s+ActiveXObject\\s*\\(\\s*['\\\"](?:MSXML2\\.XMLHTTP|Microsoft\\.XMLHTTP|WinHttp\\.WinHttpRequest\\.5\\.1)['\\\"]",
     "nocase": true
    },
    {
     "name": "s",
     "type": "ascii",
     "value": "ADODB.Stream",
     "nocase": true
    },
    {
     "name": "r",
     "type": "regex",
     "value": "WScript\\.Shell['\\\"]\\s*\\)\\s*\\.\\s*(?:Run|Exec)|\\.Run\\s*\\(",
     "nocase": true
    }
   ],
   "condition": {
    "all": [
     {
      "str": "a"
     },
     {
      "str": "s"
     },
     {
      "str": "r"
     }
    ]
   },
   "samples": {
