  {
   "id": "byte-macro-hta-activex",
   "name": "HTA or JScript launching a shell via ActiveXObject",
   "description": "hta:application or script block creating WScript.Shell and running a command.",
   "tactic": "Execution",
   "technique": "T1218.005",
   "severity": "high",
   "weight": 50,
   "applies_to": "both",
   "format": "script",
   "strings": [
    {
     "name": "h",
     "type": "regex",
     "value": "<hta:application|<script\\s+language=['\\\"]?(?:j|vb)script",
     "nocase": true
    },
    {
     "name": "a",
     "type": "regex",
     "value": "new\\s+ActiveXObject\\s*\\(\\s*['\\\"]WScript\\.Shell['\\\"]\\s*\\)|CreateObject\\s*\\(\\s*\\\"WScript\\.Shell\\\"\\s*\\)",
     "nocase": true
    },
    {
     "name": "r",
     "type": "regex",
     "value": "\\.(?:Run|Exec)\\s*\\(",
     "nocase": true
    }
   ],
   "condition": {
    "all": [
     {
      "str": "h"
     },
     {
      "str": "a"
     },
     {
      "str": "r"
     }
    ]
   },
   "samples": {
    "positive": [
     {
      "text": "<hta:application id=x><script language=\"JScript\">new ActiveXObject(\"WScript.Shell\").Run(\"cmd /c calc\")</script>"
     }
    ],
    "negative": [
     {
      "text": "<hta:application id=x><script language=\"JScript\">document.write('hi')</script>"
     },
     {
      "text": "new ActiveXObject(\"WScript.Shell\").Run(\"x\")"
     }
    ]
   }
  },
  {
   "id": "byte-macro-wsh-js-dropper",
