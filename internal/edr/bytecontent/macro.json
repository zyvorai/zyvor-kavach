      "b64": "0M8R4KGxGuFTaGVsbCgieCIp"
     }
    ]
   }
  },
  {
   "id": "byte-macro-vba-text-autoexec",
   "name": "VBA/VBS source with auto-exec entry and process launch",
   "description": "Macro text (exported module or script) with an auto-exec procedure and WScript.Shell/PowerShell/XMLHTTP use.",
   "tactic": "Execution",
   "technique": "T1059.005",
   "severity": "high",
   "weight": 50,
   "applies_to": "both",
   "format": "script",
   "strings": [
    {
     "name": "a",
     "type": "regex",
     "value": "\\bSub\\s+(?:AutoOpen|Auto_Open|Document_Open|Workbook_Open|Document_New|AutoExec)\\s*\\(",
     "nocase": true
    },
    {
     "name": "s",
     "type": "regex",
     "value": "CreateObject\\s*\\(\\s*\\\"(?:WScript\\.Shell|Shell\\.Application|MSXML2\\.(?:Server)?XMLHTTP|Microsoft\\.XMLHTTP|ADODB\\.Stream)\\\"",
     "nocase": true
    },
    {
     "name": "p",
     "type": "regex",
     "value": "powershell|cmd\\.exe|\\.Run\\b|\\.Exec\\b|ShellExecute|Shell\\s*\\(",
     "nocase": true
    }
   ],
   "condition": {
    "all": [
     {
      "str": "a"
     },
     {
      "str": "s"
     },
     {
      "str": "p"
     }
    ]
   },
   "samples": {
    "positive": [
     {
      "text": "Sub AutoOpen()\n  Set o = CreateObject(\"WScript.Shell\")\n  o.Run \"powershell -w hidden\"\nEnd Sub"
     }
    ],
    "negative": [
     {
      "text": "Sub AutoOpen()\n  MsgBox \"Welcome\"\nEnd Sub"
     },
     {
      "text": "Set o = CreateObject(\"WScript.Shell\"): o.Run \"x\""
     }
    ]
   }
  },
  {
   "id": "byte-macro-vba-downloader",
   "name": "VBA/VBS HTTP downloader that saves and runs a file",
   "description": "XMLHTTP GET, ADODB.Stream SaveToFile and a Run/Shell of the saved file.",
   "tactic": "Command and Control",
   "technique": "T1105",
   "severity": "high",
   "weight": 55,
   "applies_to": "both",
   "format": "script",
   "strings": [
    {
     "name": "h",
     "type": "regex",
     "value": "MSXML2\\.(?:Server)?XMLHTTP|Microsoft\\.XMLHTTP|WinHttp\\.WinHttpRequest",
     "nocase": true
    },
    {
     "name": "a",
     "type": "ascii",
     "value": "ADODB.Stream",
     "nocase": true
    },
    {
     "name": "s",
     "type": "ascii",
     "value": "SaveToFile",
     "nocase": true
    },
    {
     "name": "r",
     "type": "regex",
     "value": "\\.Run\\b|Shell\\s*\\(|ShellExecute|\\.Exec\\b",
     "nocase": true
    }
   ],
   "condition": {
    "all": [
     {
      "str": "h"
     },
     {
      "str": "a"
     },
     {
      "str": "s"
     },
     {
      "str": "r"
     }
    ]
   },
   "samples": {
    "positive": [
     {
      "text": "Set x=CreateObject(\"MSXML2.XMLHTTP\"): x.Open \"GET\",u: Set s=CreateObject(\"ADODB.Stream\"): s.SaveToFile p: CreateObject(\"WScript.Shell\").Run p"
     }
    ],
    "negative": [
     {
      "text": "Set x=CreateObject(\"MSXML2.XMLHTTP\"): x.Open \"GET\",u"
     },
     {
      "text": "s.SaveToFile p: Run p"
     }
    ]
   }
  },
  {
   "id": "byte-macro-vba-chr-obfuscation",
   "name": "VBA string assembly from many Chr() calls",
   "description": "Long Chr(n) & Chr(n) chains rebuild command strings; heavy use is a classic obfuscation. Some legitimate templates build strings this way, so the weight is low.",
   "tactic": "Defense Evasion",
   "technique": "T1027",
   "severity": "low",
   "weight": 12,
   "applies_to": "both",
   "format": "script",
   "tags": [
    "noisy-risk"
   ],
   "strings": [
    {
     "name": "c",
     "type": "regex",
     "value": "(?:Chr[W$]?\\(\\s*\\d{1,3}\\s*\\)\\s*&\\s*){10,}Chr[W$]?\\(\\s*\\d{1,3}\\s*\\)",
     "nocase": true
    },
    {
     "name": "e",
     "type": "regex",
     "value": "\\bShell\\b|\\.Run\\b|CreateObject|Execute",
     "nocase": true
    }
   ],
   "condition": {
    "all": [
     {
      "str": "c"
     },
     {
      "str": "e"
     }
    ]
   },
   "samples": {
    "positive": [
     {
      "text": "x = Chr(112) & Chr(111) & Chr(119) & Chr(101) & Chr(114) & Chr(115) & Chr(104) & Chr(101) & Chr(108) & Chr(108) & Chr(46) & Chr(101)\nShell x"
     }
    ],
    "negative": [
     {
      "text": "x = Chr(1) & Chr(2)\nShell x"
     },
     {
      "text": "Chr(1) & Chr(2) & Chr(3) & Chr(4) & Chr(5) & Chr(6) & Chr(7) & Chr(8) & Chr(9) & Chr(10) & Chr(11) & Chr(12)"
     }
    ]
   }
  },
