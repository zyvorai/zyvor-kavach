  {
   "id": "byte-webshell-asp-eval-request",
   "name": "ASP/ASPX eval or Execute of request input",
   "description": "Classic ASP Execute/Eval(Request(...)) and JScript eval(Request.Item[...]): the one-line ASP shell.",
   "tactic": "Persistence",
   "technique": "T1505.003",
   "severity": "critical",
   "weight": 65,
   "applies_to": "both",
   "format": "script",
   "strings": [
    {
     "name": "e",
     "type": "regex",
     "value": "(?:\\bexecute|\\beval|\\bExecuteGlobal)\\s*\\(?\\s*(?:request|Request)\\s*[\\.\\(\\[]"
    },
    {
     "name": "a",
     "type": "ascii",
     "value": "<%"
    }
   ],
   "condition": {
    "all": [
     {
      "str": "e"
     },
     {
      "str": "a"
     }
    ]
   },
   "samples": {
