     "value": "\\$_(?:POST|GET|REQUEST|COOKIE)\\s*\\[\\s*['\\\"][^'\\\"]{1,32}['\\\"]\\s*\\]\\s*\\(\\s*\\$_(?:POST|GET|REQUEST|COOKIE)"
    },
    {
     "name": "t",
     "type": "ascii",
     "value": "<?php",
