  {
   "id": "byte-webshell-jsp-runtime-exec",
   "name": "JSP command execution from request parameter",
   "description": "Runtime.getRuntime().exec() or ProcessBuilder fed by request.getParameter.",
   "tactic": "Persistence",
   "technique": "T1505.003",
   "severity": "critical",
   "weight": 65,
   "applies_to": "both",
   "format": "script",
   "strings": [
    {
     "name": "e",
     "type": "regex",
     "value": "(?:Runtime\\s*\\.\\s*getRuntime\\s*\\(\\s*\\)\\s*\\.\\s*exec|new\\s+ProcessBuilder)\\s*\\([^;]{0,120}request\\s*\\.\\s*getParameter"
    },
    {
     "name": "t",
     "type": "ascii",
     "value": "<%"
    }
   ],
   "condition": {
    "all": [
     {
      "str": "e"
     },
     {
      "str": "t"
     }
    ]
   },
   "samples": {
    "positive": [
     {
      "text": "<% Process p = Runtime.getRuntime().exec(request.getParameter(\"cmd\")); %>"
     }
    ],
    "negative": [
     {
      "text": "<% String c = request.getParameter(\"cmd\"); out.print(c); %>"
     },
     {
      "text": "<% Runtime.getRuntime().exec(\"ls\"); %>"
     }
    ]
   }
  },
  {
   "id": "byte-webshell-jsp-classloader",
