{
 "pack": "ransom",
 "rules": [
  {
   "id": "byte-ransom-note-encrypted-pay",
   "name": "Ransom note: files encrypted and payment demanded",
   "description": "Text saying files have been encrypted, naming a cryptocurrency and a way to restore them.",
   "tactic": "Impact",
   "technique": "T1486",
   "severity": "high",
   "weight": 55,
   "applies_to": "both",
   "format": "any",
   "strings": [
    {
     "name": "e",
     "type": "regex",
     "value": "(?:all\\s+)?(?:your|the)\\s+(?:important\\s+)?(?:files|data|documents|network)\\s+(?:has|have|had|is|are|were)\\s+(?:been\\s+)?(?:encrypted|locked)",
     "nocase": true
    },
    {
     "name": "p",
     "type": "regex",
     "value": "\\b(?:bitcoin|btc|monero|xmr)\\b",
     "nocase": true
    },
    {
     "name": "d",
     "type": "regex",
     "value": "decrypt|restore|recover",
     "nocase": true
    }
   ],
   "condition": {
    "all": [
     {
      "str": "e"
     },
     {
      "str": "p"
     },
     {
      "str": "d"
     }
    ]
   },
   "samples": {
    "positive": [
     {
      "text": "ATTENTION! All your files have been encrypted. To decrypt them you must pay 0.5 BTC."
     }
    ],
    "negative": [
     {
      "text": "Your invoice is attached. Please pay in bitcoin or bank transfer."
     },
     {
      "text": "All your files have been encrypted by the backup job and are stored safely, restore as needed."
     }
    ]
   }
  },
  {
   "id": "byte-ransom-note-onion-id",
   "name": "Ransom note: Tor portal and victim ID",
   "description": "A .onion contact address with a personal/victim identifier and decryption wording.",
   "tactic": "Impact",
   "technique": "T1486",
   "severity": "high",
   "weight": 55,
   "applies_to": "both",
   "format": "any",
   "strings": [
    {
     "name": "o",
     "type": "regex",
     "value": "\\b[a-z2-7]{16,56}\\.onion\\b",
     "nocase": true
    },
    {
     "name": "i",
     "type": "regex",
     "value": "(?:personal|victim|your|unique)\\s*(?:id|key|code)",
     "nocase": true
    },
    {
     "name": "d",
     "type": "regex",
     "value": "decrypt(?:or|ion|ed)?",
     "nocase": true
    },
    {
     "name": "t",
     "type": "ascii",
     "value": "Tor Browser",
     "nocase": true
    }
   ],
   "condition": {
    "all": [
     {
      "str": "o"
     },
     {
      "str": "i"
     },
     {
      "str": "d"
     },
     {
      "str": "t"
     }
    ]
   },
   "samples": {
    "positive": [
     {
      "text": "Download Tor Browser and open http://abcdefghijklmnop.onion. Enter your personal ID: 12AB to get the decryptor."
     }
    ],
    "negative": [
     {
      "text": "Visit http://abcdefghijklmnop.onion with your unique key"
     },
     {
      "text": "Download Tor Browser to browse privately."
     }
    ]
   }
  },
  {
   "id": "byte-ransom-note-leak-threat",
   "name": "Ransom note: data theft and publication threat",
   "description": "Double-extortion wording: stolen data will be published unless payment is made, with a deadline.",
   "tactic": "Impact",
   "technique": "T1657",
   "severity": "high",
   "weight": 50,
   "applies_to": "both",
   "format": "any",
   "strings": [
    {
     "name": "s",
     "type": "regex",
     "value": "(?:we\\s+(?:have\\s+)?(?:downloaded|stolen|exfiltrated|obtained)|data\\s+(?:was|has\\s+been)\\s+(?:stolen|exfiltrated))",
     "nocase": true
    },
    {
     "name": "p",
     "type": "regex",
     "value": "(?:publish|leak|sell|release)(?:ed)?\\s+(?:it|them|your|the|all)",
     "nocase": true
    },
    {
     "name": "m",
     "type": "regex",
     "value": "\\b(?:pay|payment|ransom|negotiat)\\w*",
     "nocase": true
    },
    {
     "name": "t",
     "type": "regex",
     "value": "\\b\\d+\\s*(?:hours|days)\\b",
     "nocase": true
    }
   ],
   "condition": {
    "all": [
     {
      "str": "s"
     },
     {
      "str": "p"
     },
     {
      "str": "m"
     },
     {
      "str": "t"
     }
    ]
   },
   "samples": {
    "positive": [
     {
      "text": "We have downloaded 200GB of your data. We will publish it on our blog unless you pay the ransom within 72 hours."
     }
    ],
    "negative": [
     {
      "text": "We downloaded the report and will publish it on the blog in 3 days."
     },
     {
      "text": "payment due within 30 days"
     }
    ]
   }
  },
  {
   "id": "byte-ransom-note-filenames",
   "name": "Ransom note file names and recovery instructions",
   "description": "Typical note names (HOW_TO_DECRYPT, README_TO_RESTORE, RECOVER-FILES) mentioned together with decryption instructions.",
   "tactic": "Impact",
   "technique": "T1486",
   "severity": "medium",
   "weight": 30,
   "applies_to": "both",
   "format": "any",
   "tags": [
    "noisy-risk"
   ],
   "strings": [
    {
     "name": "n",
     "type": "regex",
     "value": "(?:HOW[_ -]?TO[_ -]?(?:DECRYPT|RECOVER|RESTORE)|RESTORE[_-]?(?:MY[_-]?)?FILES|RECOVER[_-]?(?:YOUR[_-]?)?FILES|DECRYPT[_-]?(?:YOUR[_-]?)?FILES|READ[_-]?ME[_-]?TO[_-]?DECRYPT)(?:\\.\\w{2,4})?"
    },
    {
     "name": "d",
     "type": "regex",
     "value": "\\b(?:encrypted|decrypt\\w*)\\b",
     "nocase": true
    },
    {
     "name": "c",
     "type": "regex",
     "value": "\\b(?:contact|email|e-mail|wallet|key)\\b",
     "nocase": true
    }
   ],
   "condition": {
    "all": [
     {
      "str": "n"
     },
     {
      "str": "d"
     },
     {
      "str": "c"
     }
    ]
   },
   "samples": {
    "positive": [
     {
      "text": "Files are encrypted. See HOW_TO_DECRYPT.txt for instructions. Contact us by email."
     }
    ],
    "negative": [
     {
      "text": "See HOW_TO_USE.txt. Contact us by email."
     },
     {
      "text": "HOW_TO_DECRYPT.txt"
     }
    ]
   }
  },
  {
   "id": "byte-ransom-binary-note-strings",
   "name": "Executable carrying ransom-note and cipher strings",
   "description": "An executable that embeds note wording, a .onion address and file-extension lists to encrypt.",
   "tactic": "Impact",
   "technique": "T1486",
   "severity": "high",
   "weight": 50,
   "applies_to": "file",
   "format": "any",
   "strings": [
    {
     "name": "n",
     "type": "regex",
     "value": "your\\s+files\\s+(?:have\\s+been|are)\\s+(?:encrypted|locked)",
     "nocase": true
    },
    {
     "name": "o",
     "type": "regex",
     "value": "\\b[a-z2-7]{16,56}\\.onion\\b",
     "nocase": true
    },
    {
     "name": "x",
     "type": "regex",
     "value": "\\.(?:docx|xlsx|sql|mdb|vmdk|bak)\\b.{0,40}\\.(?:docx|xlsx|sql|mdb|vmdk|bak)\\b",
     "nocase": true
    },
    {
     "name": "r",
     "type": "ascii",
     "value": "AES",
     "nocase": true
    }
   ],
   "condition": {
    "all": [
     {
      "str": "n"
     },
     {
      "str": "o"
     },
     {
      "any": [
       {
        "str": "x"
       },
       {
        "str": "r"
       }
      ]
     }
    ]
   },
   "samples": {
    "positive": [
     {
      "b64": ""
     }
    ],
    "negative": [
     {
      "b64": ""
     },
     {
      "b64": ""
     }
    ]
   }
  },
  {
   "id": "byte-ransom-wallpaper-vss",
   "name": "Ransomware-style shadow deletion plus note drop",
   "description": "A script that deletes shadow copies and drops a note/wallpaper in the same file.",
   "tactic": "Impact",
   "technique": "T1490",
   "severity": "critical",
   "weight": 65,
   "applies_to": "both",
   "format": "script",
   "strings": [
    {
     "name": "v",
     "type": "regex",
     "value": "(?:vssadmin(?:\\.exe)?\\s+delete\\s+shadows|wmic\\s+shadowcopy\\s+delete|Get-WmiObject\\s+Win32_ShadowCopy[^\\n]{0,40}Delete)",
     "nocase": true
    },
    {
     "name": "n",
     "type": "regex",
     "value": "(?:HOW_TO|README|RESTORE|DECRYPT)[A-Za-z_\\-]{0,20}\\.(?:txt|html|hta)",
     "nocase": true
    },
    {
     "name": "b",
     "type": "regex",
     "value": "bcdedit[^\\n]{0,60}(?:recoveryenabled\\s+no|ignoreallfailures)",
     "nocase": true
    }
   ],
   "condition": {
    "all": [
     {
      "str": "v"
     },
     {
      "any": [
       {
        "str": "n"
       },
       {
        "str": "b"
       }
      ]
     }
    ]
   },
   "samples": {
    "positive": [
     {
      "text": "vssadmin delete shadows /all /quiet\nbcdedit /set {default} recoveryenabled no"
     }
    ],
    "negative": [
     {
      "text": "vssadmin delete shadows /all /quiet"
     },
     {
      "text": "bcdedit /set {default} recoveryenabled no"
     }
    ]
   }
  }
 ]
}
