   }
  },
  {
   "id": "byte-cred-dcsync",
   "name": "DCSync and domain secret extraction wording",
   "description": "lsadump::dcsync or DRSUAPI replication calls with krbtgt/domain targets.",
   "tactic": "Credential Access",
   "technique": "T1003.006",
   "severity": "high",
   "weight": 55,
   "applies_to": "both",
   "format": "any",
   "strings": [
    {
     "name": "a",
     "type": "regex",
     "value": "lsadump::dcsync",
     "nocase": true
    },
    {
     "name": "b",
     "type": "ascii",
     "value": "DRSGetNCChanges"
    },
    {
     "name": "c",
     "type": "ascii",
     "value": "/user:krbtgt",
     "nocase": true
    },
    {
     "name": "d",
     "type": "ascii",
     "value": "/domain:",
     "nocase": true
    }
   ],
   "condition": {
    "any": [
     {
      "all": [
       {
        "str": "a"
       },
       {
        "str": "d"
       }
      ]
     },
     {
      "all": [
       {
        "str": "b"
       },
       {
        "str": "c"
       }
      ]
     }
    ]
   },
   "samples": {
    "positive": [
     {
      "text": "lsadump::dcsync /domain:corp.local /user:krbtgt"
     }
    ],
    "negative": [
     {
      "text": "lsadump::dcsync"
     },
     {
      "text": "/user:krbtgt"
     }
    ]
   }
  },
  {
   "id": "byte-cred-lsass-minidump",
   "name": "LSASS memory dump via MiniDumpWriteDump",
   "description": "MiniDumpWriteDump together with the lsass process name in a binary or script.",
   "tactic": "Credential Access",
   "technique": "T1003.001",
   "severity": "high",
   "weight": 55,
   "applies_to": "both",
   "format": "any",
   "strings": [
    {
     "name": "m",
     "type": "ascii",
     "value": "MiniDumpWriteDump"
    },
    {
     "name": "l",
     "type": "ascii",
     "value": "lsass",
     "nocase": true
    },
    {
     "name": "lw",
     "type": "wide",
     "value": "lsass.exe",
     "nocase": true
    }
   ],
   "condition": {
    "all": [
     {
      "str": "m"
     },
     {
      "any": [
       {
        "str": "l"
       },
       {
        "str": "lw"
       }
      ]
     }
    ]
   },
   "samples": {
    "positive": [
     {
      "b64": ""
     }
    ],
    "negative": [
     {
      "b64": ""
     },
     {
      "b64": ""
     }
    ]
   }
  },
  {
   "id": "byte-cred-comsvcs-minidump",
   "name": "comsvcs.dll MiniDump command",
   "description": "rundll32 comsvcs.dll MiniDump against a process id with the full-dump keyword.",
   "tactic": "Credential Access",
   "technique": "T1003.001",
   "severity": "high",
   "weight": 60,
   "applies_to": "both",
   "format": "script",
   "strings": [
    {
     "name": "a",
     "type": "regex",
     "value": "comsvcs(?:\\.dll)?\\s*,\\s*(?:#?24|MiniDump)\\b[^\\n]{0,80}(?:full|\\.dmp)",
     "nocase": true
    },
    {
     "name": "b",
     "type": "ascii",
     "value": "rundll32",
     "nocase": true
    }
   ],
   "condition": {
    "all": [
     {
      "str": "a"
     },
     {
      "str": "b"
     }
    ]
   },
   "samples": {
    "positive": [
     {
      "text": "rundll32.exe C:\\windows\\system32\\comsvcs.dll, MiniDump 624 C:\\t\\l.dmp full"
     }
    ],
    "negative": [
     {
      "text": "rundll32.exe shell32.dll,Control_RunDLL"
     },
     {
      "text": "comsvcs.dll, MiniDump"
     }
    ]
   }
  },
  {
   "id": "byte-cred-procdump-lsass",
   "name": "ProcDump against lsass",
   "description": "procdump with -ma (or -mm) and the lsass target.",
   "tactic": "Credential Access",
   "technique": "T1003.001",
   "severity": "high",
   "weight": 50,
   "applies_to": "both",
   "format": "any",
   "strings": [
    {
     "name": "a",
     "type": "regex",
     "value": "procdump(?:64)?(?:\\.exe)?\\s+[^\\n]{0,40}-m[am]\\s+[^\\n]{0,40}lsass",
     "nocase": true
    }
   ],
   "condition": {
    "str": "a"
   },
   "samples": {
    "positive": [
     {
      "text": "procdump.exe -accepteula -ma lsass.exe lsass.dmp"
     }
    ],
    "negative": [
     {
      "text": "procdump -ma myapp.exe app.dmp"
     },
     {
      "text": "lsass"
     }
    ]
   }
  },
  {
   "id": "byte-cred-sam-hive-save",
   "name": "Registry hive export of SAM/SECURITY/SYSTEM",
   "description": "reg save of the SAM or SECURITY hive.",
   "tactic": "Credential Access",
   "technique": "T1003.002",
   "severity": "high",
   "weight": 50,
   "applies_to": "both",
   "format": "any",
   "strings": [
    {
     "name": "a",
     "type": "regex",
     "value": "reg(?:\\.exe)?\\s+save\\s+hk(?:lm|ey_local_machine)\\\\(?:sam|security)\\b",
     "nocase": true
    }
   ],
   "condition": {
    "str": "a"
   },
   "samples": {
    "positive": [
     {
      "text": "reg save HKLM\\SAM C:\\temp\\sam.hive"
     }
    ],
    "negative": [
     {
      "text": "reg save HKLM\\SOFTWARE\\Vendor x.hive"
     },
     {
      "text": "HKLM\\SAM"
     }
    ]
   }
  },
  {
   "id": "byte-cred-ntds-extract",
   "name": "NTDS.dit extraction commands",
   "description": "ntdsutil snapshot/ifm or vssadmin copy of ntds.dit.",
   "tactic": "Credential Access",
   "technique": "T1003.003",
   "severity": "high",
   "weight": 55,
   "applies_to": "both",
   "format": "any",
   "strings": [
    {
     "name": "n",
     "type": "ascii",
     "value": "ntds.dit",
     "nocase": true
    },
    {
     "name": "c",
     "type": "regex",
     "value": "ntdsutil[^\\n]{0,60}(?:ifm|snapshot|ac\\s+i\\s+ntds)|vssadmin\\s+create\\s+shadow|copy\\s+\\\\\\\\\\?\\\\GLOBALROOT\\\\Device\\\\HarddiskVolumeShadowCopy\\d+",
     "nocase": true
    }
   ],
   "condition": {
    "all": [
     {
      "str": "n"
     },
     {
      "str": "c"
     }
    ]
   },
   "samples": {
    "positive": [
     {
      "text": "ntdsutil \"ac i ntds\" \"ifm\" \"create full c:\\x\" q q # ntds.dit"
     }
    ],
    "negative": [
     {
      "text": "ntds.dit is the database"
     },
     {
      "text": "ntdsutil metadata cleanup"
     }
    ]
   }
  },
  {
