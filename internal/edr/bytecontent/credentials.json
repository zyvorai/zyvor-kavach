{
 "pack": "credentials",
 "rules": [
  {
   "id": "byte-cred-mimikatz-strings",
   "name": "Mimikatz command module strings",
   "description": "sekurlsa/lsadump/kerberos module names together with the author banner.",
   "tactic": "Credential Access",
   "technique": "T1003.001",
   "severity": "critical",
   "weight": 75,
   "applies_to": "both",
   "format": "any",
   "strings": [
    {
     "name": "a",
     "type": "ascii",
     "value": "sekurlsa::",
     "nocase": true
    },
    {
     "name": "b",
     "type": "ascii",
     "value": "gentilkiwi",
     "nocase": true
    },
    {
     "name": "c",
     "type": "ascii",
     "value": "logonpasswords",
     "nocase": true
    },
    {
     "name": "d",
     "type": "ascii",
     "value": "lsadump::",
     "nocase": true
    },
    {
     "name": "e",
     "type": "ascii",
     "value": "kerberos::",
     "nocase": true
    }
   ],
   "condition": {
    "all": [
     {
      "any": [
       {
        "str": "a"
       },
       {
        "str": "d"
       },
       {
        "str": "e"
       }
      ]
     },
     {
      "any": [
       {
        "str": "b"
       },
       {
        "str": "c"
       }
      ]
     }
    ]
   },
   "samples": {
    "positive": [
     {
      "text": "mimikatz # sekurlsa::logonpasswords  (gentilkiwi)"
     }
    ],
    "negative": [
     {
      "text": "sekurlsa:: unknown module"
     },
     {
      "text": "benjamin delpy and gentilkiwi on twitter"
     }
    ]
   }
  },
  {
