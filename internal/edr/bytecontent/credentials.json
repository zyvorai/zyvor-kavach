   "severity": "high",
   "weight": 50,
   "applies_to": "both",
   "format": "any",
   "strings": [
    {
     "name": "k",
     "type": "ascii",
     "value": "kerberoast",
     "nocase": true
    },
    {
     "name": "a",
     "type": "ascii",
     "value": "asktgt",
     "nocase": true
    },
    {
