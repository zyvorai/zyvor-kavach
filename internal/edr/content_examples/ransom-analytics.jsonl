# Original, minimal examples for the built-in analytic rules. One positive and one negative (a near miss) per rule.
{"schema":"kavach-content-tests/1","name":"ransomware-log analytic rules"}
{"case":"rwlog-an-mass-rename positive: 55 renames in 27 s keeping the extension","kind":"ransom","rule":"rwlog-an-mass-rename","polarity":"positive","gen":[{"count":55,"step_ms":500,"template":{"time":"{t}","host":"fs01","op":"rename","path":"/data/a/f{i}.txt","new_path":"/data/a/g{i}.txt"}}]}
{"case":"rwlog-an-mass-rename negative: 40 renames in 20 s","kind":"ransom","rule":"rwlog-an-mass-rename","polarity":"negative","gen":[{"count":40,"step_ms":500,"template":{"time":"{t}","host":"fs01","op":"rename","path":"/data/a/f{i}.txt","new_path":"/data/a/g{i}.txt"}}]}
{"case":"rwlog-an-extension-churn positive: 35 files renamed to .locked in 35 s","kind":"ransom","rule":"rwlog-an-extension-churn","polarity":"positive","gen":[{"count":35,"step_ms":1000,"template":{"time":"{t}","host":"fs01","op":"rename","path":"/d/f{i}.docx","new_path":"/d/f{i}.docx.locked"}}]}
{"case":"rwlog-an-extension-churn negative: 20 files renamed to .locked","kind":"ransom","rule":"rwlog-an-extension-churn","polarity":"negative","gen":[{"count":20,"step_ms":1000,"template":{"time":"{t}","host":"fs01","op":"rename","path":"/d/f{i}.docx","new_path":"/d/f{i}.docx.locked"}}]}
{"case":"rwlog-an-high-entropy-writes positive: 35 writes with entropy 7.9","kind":"ransom","rule":"rwlog-an-high-entropy-writes","polarity":"positive","gen":[{"count":35,"step_ms":1000,"template":{"time":"{t}","host":"fs01","op":"write","path":"/d/f{i}","entropy":7.9}}]}
{"case":"rwlog-an-high-entropy-writes negative: 35 writes with entropy 6.0","kind":"ransom","rule":"rwlog-an-high-entropy-writes","polarity":"negative","gen":[{"count":35,"step_ms":1000,"template":{"time":"{t}","host":"fs01","op":"write","path":"/d/f{i}","entropy":6.0}}]}
{"case":"rwlog-an-ransom-note-spread positive: one note name created in 6 directories","kind":"ransom","rule":"rwlog-an-ransom-note-spread","polarity":"positive","gen":[{"count":6,"step_ms":2000,"template":{"time":"{t}","host":"fs01","op":"create","path":"/home/u{i}/README_TO_DECRYPT.txt"}}]}
{"case":"rwlog-an-ransom-note-spread negative: one note name created in 4 directories","kind":"ransom","rule":"rwlog-an-ransom-note-spread","polarity":"negative","gen":[{"count":4,"step_ms":2000,"template":{"time":"{t}","host":"fs01","op":"create","path":"/home/u{i}/README_TO_DECRYPT.txt"}}]}
{"case":"rwlog-an-mass-delete positive: 110 deletions in 44 s","kind":"ransom","rule":"rwlog-an-mass-delete","polarity":"positive","gen":[{"count":110,"step_ms":400,"template":{"time":"{t}","host":"fs01","op":"delete","path":"/tmp/f{i}"}}]}
{"case":"rwlog-an-mass-delete negative: 80 deletions in 32 s","kind":"ransom","rule":"rwlog-an-mass-delete","polarity":"negative","gen":[{"count":80,"step_ms":400,"template":{"time":"{t}","host":"fs01","op":"delete","path":"/tmp/f{i}"}}]}
{"case":"rwlog-an-recovery-inhibit-command positive: shadow copy deletion command","kind":"ransom","rule":"rwlog-an-recovery-inhibit-command","polarity":"positive","records":[{"time":"2026-01-15T10:00:00Z","host":"fs01","command":"cmd /c vssadmin.exe delete shadows /all /quiet"}]}
{"case":"rwlog-an-recovery-inhibit-command negative: shadow copy listing command","kind":"ransom","rule":"rwlog-an-recovery-inhibit-command","polarity":"negative","records":[{"time":"2026-01-15T10:00:00Z","host":"fs01","command":"cmd /c vssadmin.exe list shadows"}]}
{"case":"rwlog-an-backup-deletion positive: 3 restore points deleted in 3 minutes","kind":"ransom","rule":"rwlog-an-backup-deletion","polarity":"positive","gen":[{"count":3,"step_ms":60000,"template":{"time":"{t}","host":"bk01","event":"Restore point deleted"}}]}
{"case":"rwlog-an-backup-deletion negative: 3 restore points created in 3 minutes","kind":"ransom","rule":"rwlog-an-backup-deletion","polarity":"negative","gen":[{"count":3,"step_ms":60000,"template":{"time":"{t}","host":"bk01","event":"Restore point created"}}]}
{"case":"rwlog-an-backup-config-weakened positive: backup job disabled","kind":"ransom","rule":"rwlog-an-backup-config-weakened","polarity":"positive","records":[{"time":"2026-01-15T10:00:00Z","host":"bk01","job":"nightly","event":"Job disabled"}]}
{"case":"rwlog-an-backup-config-weakened negative: backup job completed","kind":"ransom","rule":"rwlog-an-backup-config-weakened","polarity":"negative","records":[{"time":"2026-01-15T10:00:00Z","host":"bk01","job":"nightly","event":"Job completed"}]}
{"case":"rwlog-an-backup-malware-flag positive: backup product flags malware activity","kind":"ransom","rule":"rwlog-an-backup-malware-flag","polarity":"positive","records":[{"time":"2026-01-15T10:00:00Z","host":"bk01","job":"nightly","event":"Malware Activity Detected"}]}
{"case":"rwlog-an-backup-malware-flag negative: backup completed without flags","kind":"ransom","rule":"rwlog-an-backup-malware-flag","polarity":"negative","records":[{"time":"2026-01-15T10:00:00Z","host":"bk01","job":"nightly","event":"Job completed","message":"no issues found"}]}
{"case":"rwlog-an-backup-change-spike positive: fourth run is 5x the median","kind":"ransom","rule":"rwlog-an-backup-change-spike","polarity":"positive","records":[{"time":"2026-01-11T02:00:00Z","host":"bk01","job":"nightly","event":"Job finished","backup_size":1000},{"time":"2026-01-12T02:00:00Z","host":"bk01","job":"nightly","event":"Job finished","backup_size":1000},{"time":"2026-01-13T02:00:00Z","host":"bk01","job":"nightly","event":"Job finished","backup_size":1000},{"time":"2026-01-14T02:00:00Z","host":"bk01","job":"nightly","event":"Job finished","backup_size":5000}]}
{"case":"rwlog-an-backup-change-spike negative: fourth run is 1.2x the median","kind":"ransom","rule":"rwlog-an-backup-change-spike","polarity":"negative","records":[{"time":"2026-01-11T02:00:00Z","host":"bk01","job":"nightly","event":"Job finished","backup_size":1000},{"time":"2026-01-12T02:00:00Z","host":"bk01","job":"nightly","event":"Job finished","backup_size":1000},{"time":"2026-01-13T02:00:00Z","host":"bk01","job":"nightly","event":"Job finished","backup_size":1000},{"time":"2026-01-14T02:00:00Z","host":"bk01","job":"nightly","event":"Job finished","backup_size":1200}]}
{"case":"rwlog-an-backup-tamper-near-encryption positive: shadow copy deletion then a backup malware flag 10 minutes later","kind":"ransom","rule":"rwlog-an-backup-tamper-near-encryption","polarity":"positive","records":[{"time":"2026-01-15T10:00:00Z","host":"fs01","command":"cmd /c vssadmin.exe delete shadows /all /quiet"},{"time":"2026-01-15T10:10:00Z","host":"bk01","job":"nightly","event":"Malware Activity Detected"}]}
{"case":"rwlog-an-backup-tamper-near-encryption negative: shadow copy deletion then a backup malware flag 3 hours later","kind":"ransom","rule":"rwlog-an-backup-tamper-near-encryption","polarity":"negative","records":[{"time":"2026-01-15T10:00:00Z","host":"fs01","command":"cmd /c vssadmin.exe delete shadows /all /quiet"},{"time":"2026-01-15T13:00:00Z","host":"bk01","job":"nightly","event":"Malware Activity Detected"}]}
