# Original, minimal examples for the built-in analytic rules. One positive and one negative (a near miss) per rule.
{"schema":"kavach-content-tests/1","name":"authentication-log analytic rules"}
{"case":"auth-an-credential-stuffing positive: 60 failures against 25 accounts from 12 sources","kind":"auth","rule":"auth-an-credential-stuffing","polarity":"positive","gen":[{"count":60,"step_ms":1000,"template":{"time":"{t}","user":"u{i%25}","ip":"198.51.100.{i%12}","outcome":"failure"}}]}
{"case":"auth-an-credential-stuffing negative: 60 failures against only 10 accounts","kind":"auth","rule":"auth-an-credential-stuffing","polarity":"negative","gen":[{"count":60,"step_ms":1000,"template":{"time":"{t}","user":"u{i%10}","ip":"198.51.100.{i%12}","outcome":"failure"}}]}
{"case":"auth-an-distributed-account-attack positive: one account failing from 10 sources","kind":"auth","rule":"auth-an-distributed-account-attack","polarity":"positive","gen":[{"count":10,"step_ms":1000,"template":{"time":"{t}","user":"alice","ip":"198.51.100.{i}","outcome":"failure"}}]}
{"case":"auth-an-distributed-account-attack negative: one account failing from 7 sources","kind":"auth","rule":"auth-an-distributed-account-attack","polarity":"negative","gen":[{"count":7,"step_ms":1000,"template":{"time":"{t}","user":"alice","ip":"198.51.100.{i}","outcome":"failure"}}]}
{"case":"auth-an-high-velocity positive: 110 attempts from one source in 11 s","kind":"auth","rule":"auth-an-high-velocity","polarity":"positive","gen":[{"count":110,"step_ms":100,"template":{"time":"{t}","user":"u{i%5}","ip":"203.0.113.50","outcome":"failure"}}]}
{"case":"auth-an-high-velocity negative: 90 attempts from one source in 9 s","kind":"auth","rule":"auth-an-high-velocity","polarity":"negative","gen":[{"count":90,"step_ms":100,"template":{"time":"{t}","user":"u{i%5}","ip":"203.0.113.50","outcome":"failure"}}]}
{"case":"auth-an-success-after-failures positive: 6 failures against 6 accounts then a success from the same source","kind":"auth","rule":"auth-an-success-after-failures","polarity":"positive","gen":[{"count":6,"step_ms":1000,"template":{"time":"{t}","user":"u{i}","ip":"203.0.113.60","outcome":"failure"}}],"records":[{"time":"2026-01-15T10:05:00Z","user":"u3","ip":"203.0.113.60","outcome":"success"}]}
{"case":"auth-an-success-after-failures negative: 4 failures then a success from the same source","kind":"auth","rule":"auth-an-success-after-failures","polarity":"negative","gen":[{"count":4,"step_ms":1000,"template":{"time":"{t}","user":"u{i}","ip":"203.0.113.60","outcome":"failure"}}],"records":[{"time":"2026-01-15T10:05:00Z","user":"u3","ip":"203.0.113.60","outcome":"success"}]}
{"case":"auth-an-impossible-travel positive: New York to London in 30 minutes","kind":"auth","rule":"auth-an-impossible-travel","polarity":"positive","records":[{"time":"2026-01-15T10:00:00Z","user":"dana","ip":"203.0.113.70","outcome":"success","lat":40.71,"lon":-74.0},{"time":"2026-01-15T10:30:00Z","user":"dana","ip":"198.51.100.70","outcome":"success","lat":51.5,"lon":-0.12}]}
{"case":"auth-an-impossible-travel negative: New York to London in 8 hours","kind":"auth","rule":"auth-an-impossible-travel","polarity":"negative","records":[{"time":"2026-01-15T10:00:00Z","user":"dana","ip":"203.0.113.70","outcome":"success","lat":40.71,"lon":-74.0},{"time":"2026-01-15T18:00:00Z","user":"dana","ip":"198.51.100.70","outcome":"success","lat":51.5,"lon":-0.12}]}
{"case":"auth-an-country-change-fast positive: US then DE within 20 minutes, no coordinates","kind":"auth","rule":"auth-an-country-change-fast","polarity":"positive","records":[{"time":"2026-01-15T10:00:00Z","user":"erin","ip":"203.0.113.80","outcome":"success","country":"US"},{"time":"2026-01-15T10:20:00Z","user":"erin","ip":"198.51.100.80","outcome":"success","country":"DE"}]}
{"case":"auth-an-country-change-fast negative: US then DE three hours apart","kind":"auth","rule":"auth-an-country-change-fast","polarity":"negative","records":[{"time":"2026-01-15T10:00:00Z","user":"erin","ip":"203.0.113.80","outcome":"success","country":"US"},{"time":"2026-01-15T13:00:00Z","user":"erin","ip":"198.51.100.80","outcome":"success","country":"DE"}]}
