FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod ./
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /kavach-mcp ./cmd/kavach-mcp

FROM alpine:3.24
RUN addgroup -S kavach && adduser -S -G kavach kavach
USER kavach
COPY --from=build /kavach-mcp /usr/local/bin/kavach-mcp
LABEL io.modelcontextprotocol.server.name="io.github.zyvorai/kavach"
ENTRYPOINT ["/usr/local/bin/kavach-mcp"]
